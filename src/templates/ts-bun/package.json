{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "cd backend && {{BACKEND_RUN}} dev",
    "dev:full": "concurrently \"{{RUN}} dev\" \"{{RUN}} dev:server\"",
    "build": "tsc -b && vite build && {{RUN}} build:backend",
    "build:backend": "cd backend && {{BACKEND_RUN}} build",
    "start": "cd backend && {{BACKEND_RUN}} start",
    "preview": "vite preview",
    "install:backend": "cd backend && {{BACKEND_INSTALL}}"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}